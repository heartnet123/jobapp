{
  "name": "job-application-tracker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:contract": "node --experimental-strip-types src/shared/contract-test.ts",
    "test": "npm run test:contract && npm run test:daemon",
    "test:daemon": "vitest run src/daemon/server.test.ts",
    "daemon": "tsx src/daemon/server.ts"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "vue": "^3.5.13",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/sqlite3": "^3.1.11",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "playwright": "^1.60.0",
    "tsx": "^4.22.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^4.1.7",
    "vue-tsc": "^2.2.0"
  }
}
