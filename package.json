{
  "name": "job-application-tracker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n frontend,backend -c cyan,yellow \"bun --filter @jobapp/frontend dev\" \"bun --filter @jobapp/backend dev\"",
    "dev:frontend": "bun --filter @jobapp/frontend dev",
    "dev:backend": "bun --filter @jobapp/backend dev",
    "build": "bun --filter @jobapp/frontend build",
    "preview": "bun --filter @jobapp/frontend preview",
    "test": "bun run test:contract && bun run test:backend",
    "test:contract": "bun --filter @jobapp/shared test",
    "test:backend": "bun --filter @jobapp/backend test",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "oxlint": "^1.81.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.0": true,
    "sqlite3@6.0.1": true
  }
}
