# ==============================================================================
# Job Application Tracker - Environment Variables Template
# Copy this file to '.env' and fill in your custom values.
# DO NOT commit the actual '.env' file containing secrets to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Daemon Server Configuration
# ------------------------------------------------------------------------------
# The port where the backend daemon server runs (defaults to 3001)
PORT=1455

# The file path to the SQLite database (defaults to '../../jobs.db')
JOBS_DB_PATH=../../jobs.db


# ------------------------------------------------------------------------------
# 2. Google OAuth (Gmail Automation)
# ------------------------------------------------------------------------------
# Instructions:
# 1. Go to Google Cloud Console (https://console.cloud.google.com)
# 2. Create a project, enable Gmail API.
# 3. Configure OAuth consent screen (Testing mode, add your Gmail as test user).
# 4. Create OAuth Client ID credentials (Web Application type).
# 5. Add authorized redirect URI: http://localhost:3001/api/gmail/oauth/callback

GOOGLE_OAUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:1455/api/gmail/oauth/callback

# How often the system polls Gmail for new messages in milliseconds (e.g., 10 minutes)
GMAIL_POLL_INTERVAL_MS=600000


# ------------------------------------------------------------------------------
# 3. OpenAI Codex (ChatGPT Plus / Free / Pro OAuth Connection)
# ------------------------------------------------------------------------------
# Instructions:
# These settings allow connecting the system directly to your ChatGPT Plus subscription
# to use its free/included message quota instead of paying for OpenAI API credits.
#
# Default values for official OpenAI Codex CLI clients:
# - Client ID: official Codex application client
# - Auth URL: https://auth.openai.com/oauth/authorize
# - Token URL: https://auth.openai.com/oauth/token
# - Account URL: https://chatgpt.com/backend-api/accounts/check/v4-2023-04-27
# - Redirect URI: Codex OAuth allow-list expects http://localhost:1455/auth/callback

OPENAI_CODEX_CLIENT_ID=app_EMoamEEZ73f0CkXaXp7hrann
OPENAI_CODEX_REDIRECT_URI=http://localhost:1455/auth/callback

# Optional overrides (uncomment to customize)
# OPENAI_CODEX_MODEL=gpt-4o
# OPENAI_CODEX_AUTH_URL=https://auth.openai.com/oauth/authorize
# OPENAI_CODEX_TOKEN_URL=https://auth.openai.com/oauth/token
# OPENAI_CODEX_ACCOUNT_URL=https://chatgpt.com/backend-api/accounts/check/v4-2023-04-27
# OPENAI_CODEX_SCOPE=openid profile email offline_access
# Codex backend endpoint. Keep this on chatgpt.com to use ChatGPT/Codex auth instead of Platform API-key billing.
# OPENAI_CODEX_RESPONSES_URL=https://chatgpt.com/backend-api/codex/responses


# ------------------------------------------------------------------------------
# 4. NVIDIA NIM (Alternative AI Classifier Provider)
# ------------------------------------------------------------------------------
# Instructions:
# Used as an alternative when ChatGPT Plus is not connected.
# 1. Sign up on NVIDIA Build (https://build.nvidia.com/)
# 2. Generate a free/paid API key.
# 3. Provide the model name you wish to use (e.g., meta/llama-3.1-405b-instruct)
# 4. Optionally provide a custom endpoint path if using a different provider
#    (defaults to /chat/completions for NVIDIA NIM)

NVIDIA_NIM_API_KEY=nvapi-your-nvidia-nim-api-key
NVIDIA_NIM_MODEL=meta/llama-3.1-405b-instruct
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_NIM_ENDPOINT_PATH=/chat/completions
